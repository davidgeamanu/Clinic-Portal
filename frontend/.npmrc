# React 19 is newer than the peer ranges declared by several dependencies in
# this shadcn scaffold — react-day-picker@8 pins ^16 || ^17 || ^18, and it is
# not alone. They work correctly at runtime, but npm's strict peer resolution
# (default since npm 7) refuses to install the tree at all, so `npm ci` fails.
#
# This file makes local installs and CI behave identically. Without it, a
# developer whose node_modules predates the React 19 upgrade keeps working
# while CI cannot install anything.
#
# Revisit when react-day-picker is upgraded to v9, which supports React 19 but
# changes the API that components/ui/calendar.tsx is written against.
legacy-peer-deps=true
