# Copy to .env for docker compose (all have safe dev defaults except Mailtrap).

# PostgreSQL password (both services)
DB_PASS=postgres

# JWT signing secret — must be at least 32 bytes and identical for both services
JWT_SECRET=dev-only-jwt-secret-change-me-32-bytes-min

# Optional: enables Claude-powered symptom triage (keyword fallback when empty)
ANTHROPIC_API_KEY=

# Optional: email notifications via Mailtrap
MAIL_ENABLED=false
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
